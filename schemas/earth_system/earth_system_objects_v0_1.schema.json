{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://climateos.local/schemas/earth_system_objects_v0_1.schema.json",
  "title": "ClimateOS Earth System Objects v0.1",
  "type": "object",
  "required": ["object_type", "object_id", "version"],
  "properties": {
    "object_type": {
      "type": "string",
      "enum": [
        "EarthSystemContext",
        "GlobalClimateDriver",
        "TeleconnectionRelationship",
        "RegionalClimateResponse",
        "EnvironmentalCondition",
        "HazardCandidate",
        "Exposure",
        "Vulnerability",
        "ObservedEvent",
        "ObservedImpact",
        "EvidenceReference",
        "ProviderReference",
        "GovernanceContext"
      ]
    },
    "object_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "spatial_scope": {"type": ["string", "object", "null"]},
    "temporal_validity": {
      "type": ["object", "null"],
      "properties": {
        "start": {"type": ["string", "null"], "format": "date-time"},
        "end": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "hemisphere_context": {
      "type": ["string", "null"],
      "enum": ["northern", "southern", "equatorial", "global", "not_applicable", null]
    },
    "season_context": {"type": ["string", "null"]},
    "confidence": {
      "type": ["string", "null"],
      "enum": ["very_low", "low", "medium", "high", "very_high", null]
    },
    "uncertainty": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["dimension", "description"],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "measurement",
              "model",
              "scenario",
              "spatial_transfer",
              "temporal_transfer",
              "attribution",
              "provider",
              "transformation",
              "other"
            ]
          },
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "validation_status": {
      "type": ["string", "null"],
      "enum": [
        "hypothesis",
        "literature_supported",
        "observationally_supported",
        "model_supported",
        "multi_source_supported",
        "validated_for_scope",
        "contested",
        "rejected",
        null
      ]
    },
    "evidence_references": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "provider_references": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"object_type": {"const": "GlobalClimateDriver"}}},
      "then": {
        "required": ["hemisphere_context", "season_context", "confidence", "uncertainty", "validation_status", "payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["canonical_name", "driver_class", "state_or_phase", "spatial_scale", "temporal_scale"],
            "properties": {
              "canonical_name": {"type": "string"},
              "aliases": {"type": "array", "items": {"type": "string"}},
              "driver_class": {"type": "string"},
              "state_or_phase": {"type": "string"},
              "index_reference": {"type": ["string", "null"]},
              "observation_window": {"type": ["object", "null"]},
              "forecast_window": {"type": ["object", "null"]},
              "spatial_scale": {"type": "string"},
              "temporal_scale": {"type": "string"},
              "mechanism_references": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {"properties": {"object_type": {"const": "TeleconnectionRelationship"}}},
      "then": {
        "required": ["confidence", "uncertainty", "validation_status", "evidence_references", "payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["source_object_id", "target_object_id", "relationship_type", "seasonality", "lag_window", "spatial_applicability"],
            "properties": {
              "source_object_id": {"type": "string"},
              "target_object_id": {"type": "string"},
              "relationship_type": {
                "type": "string",
                "enum": [
                  "DRIVES",
                  "MODULATES",
                  "INFLUENCES",
                  "CONDITIONS",
                  "AMPLIFIES",
                  "SUPPRESSES",
                  "SHIFTS",
                  "CONSTRAINS",
                  "CO_OCCURS_WITH",
                  "OBSERVED_AS",
                  "EXPOSES",
                  "AFFECTS",
                  "SUPPORTED_BY",
                  "CONTESTED_BY",
                  "VALID_WITHIN",
                  "GOVERNED_BY"
                ]
              },
              "direction_vocabulary": {"type": ["string", "null"]},
              "strength_vocabulary": {"type": ["string", "null"]},
              "seasonality": {"type": "string"},
              "lag_window": {"type": ["string", "object"]},
              "spatial_applicability": {"type": ["string", "object"]},
              "competing_hypothesis_ids": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
