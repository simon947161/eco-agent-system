{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://climateos.example/schemas/time_bounded_environmental_answer.v0.1.json",
  "title": "ClimateOS Time-Bounded Environmental Answer",
  "type": "object",
  "required": [
    "schema_id",
    "answer_id",
    "question",
    "decision_use",
    "place",
    "spatial_boundary",
    "assessment_period",
    "evidence_cutoff",
    "issued_at",
    "valid_until",
    "conclusion_level",
    "evidence_maturity",
    "answer",
    "confidence",
    "supporting_evidence",
    "conflicting_evidence",
    "missing_critical_evidence",
    "local_translation_path",
    "alternative_explanations",
    "consequence_if_true",
    "consequence_if_false",
    "intervention_window",
    "permitted_actions",
    "prohibited_actions",
    "update_triggers",
    "demotion_triggers",
    "stop_conditions",
    "human_review",
    "official_confirmation",
    "retrospective_validation"
  ],
  "properties": {
    "schema_id": {
      "const": "climateos.time_bounded_environmental_answer.v0.1"
    },
    "answer_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "decision_use": {"type": "string", "minLength": 1},
    "place": {"type": "string", "minLength": 1},
    "spatial_boundary": {"type": "string", "minLength": 1},
    "assessment_period": {"type": "string", "minLength": 1},
    "evidence_cutoff": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "minLength": 1},
    "valid_until": {"type": "string", "minLength": 1},
    "conclusion_level": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4"]
    },
    "evidence_maturity": {
      "type": "string",
      "enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7"]
    },
    "answer": {"type": "string", "minLength": 1},
    "confidence": {"type": "string", "minLength": 1},
    "supporting_evidence": {"type": "array"},
    "conflicting_evidence": {"type": "array"},
    "missing_critical_evidence": {"type": "array"},
    "local_translation_path": {"type": "array"},
    "alternative_explanations": {"type": "array"},
    "consequence_if_true": {"type": "string"},
    "consequence_if_false": {"type": "string"},
    "intervention_window": {"type": "string"},
    "permitted_actions": {"type": "array"},
    "prohibited_actions": {"type": "array"},
    "update_triggers": {"type": "array"},
    "demotion_triggers": {"type": "array"},
    "stop_conditions": {"type": "array"},
    "human_review": {"type": "object"},
    "official_confirmation": {"type": "object"},
    "retrospective_validation": {"type": "object"}
  }
}
