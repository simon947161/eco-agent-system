{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://climateos.local/schemas/mission_runtime/mission_plan_contract_v0_1.schema.json",
  "title": "Mission Plan Contract v0.1",
  "type": "object",
  "required": ["mission_id", "objective", "work_packages", "capability_envelope", "validation_plan", "stop_conditions"],
  "properties": {
    "mission_id": {"type": "string"},
    "objective": {"type": "string", "minLength": 1},
    "domain_runtime": {"enum": ["MISSION_CONTROL", "CLIMATEOS", "BUILDINGOS", "WATEROS", "ENERGYOS", "CARBONOS", "SHARED"]},
    "work_packages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "deliverables", "dependencies", "completion_criteria"],
        "properties": {
          "id": {"type": "string"}, "purpose": {"type": "string"},
          "deliverables": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "completion_criteria": {"type": "array", "items": {"type": "string"}},
          "validation_method": {"type": "array", "items": {"type": "string"}}
        }, "additionalProperties": false
      }
    },
    "capability_envelope": {
      "type": "object",
      "required": ["allowed_tools", "protected_writes", "network_access", "external_contact", "merge_authority"],
      "properties": {
        "allowed_tools": {"type": "array", "items": {"type": "string"}},
        "protected_writes": {"type": "array", "items": {"type": "string"}},
        "network_access": {"type": "boolean"}, "external_contact": {"type": "boolean"},
        "merge_authority": {"type": "boolean"}, "child_may_widen": {"const": false}
      }, "additionalProperties": false
    },
    "validation_plan": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "founder_gate": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}