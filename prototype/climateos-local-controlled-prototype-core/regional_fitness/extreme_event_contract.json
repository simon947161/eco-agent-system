    {"event_type": "meteorological_drought", "required_variables": ["precipitation_amount"], "required_declarations": ["index_method", "accumulation_period", "reference_period"], "prohibited_inference": "not automatically agricultural, hydrological or ecological drought"},
    {"event_type": "strong_wind", "required_variables": ["wind_speed"], "required_declarations": ["gust_or_mean", "averaging_window", "measurement_height"]},
    {"event_type": "dust_or_sand", "region_restriction": ["CN-XJ-KARAMAY"], "required_variables": ["visibility_or_weather_phenomenon_code", "wind_speed"], "block_if_missing": ["visibility_or_weather_phenomenon_code"]},
    {"event_type": "hot_dry_windy_compound", "required_variables": ["temperature", "relative_humidity", "wind_speed"], "prohibited_inference": "not automatically a fire occurrence or official fire danger rating"}
