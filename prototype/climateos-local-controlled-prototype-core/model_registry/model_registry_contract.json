{
  "contract_version": "0.1",
  "task_range": "Task1200-1219",
  "purpose": "Register declared model identity, provenance, licence, interfaces and limitations without executing, scoring or admitting the model.",
  "required": [
    "registry_id",
    "model_name",
    "model_owner_or_maintainer",
    "model_version",
    "canonical_source",
    "source_version_or_commit",
    "licence_name",
    "licence_status",
    "model_status",
    "model_class",
    "input_contract",
    "output_contract",
    "spatial_resolution",
    "temporal_resolution",
    "training_data_declaration",
    "evaluation_data_declaration",
    "known_limitations",
    "declared_by",
    "human_review_status",
    "evidence_refs",
    "uncertainty",
    "created_at",
    "updated_at"
  ],
  "model_statuses": ["research", "experimental", "pre_operational", "operational_service_claimed", "retired", "unknown"],
  "model_classes": ["physics_based", "machine_learning", "hybrid", "statistical", "diagnostic_framework", "unknown"],
  "licence_states": ["verified", "review_required", "unknown", "restricted", "incompatible"],
  "human_review_states": ["not_reviewed", "metadata_reviewed", "disputed", "correction_required"],
  "blocking_conditions": [
    "missing_canonical_source",
    "missing_or_unknown_version",
    "licence_review_required_or_worse",
    "training_data_not_declared",
    "evaluation_data_not_declared",
    "known_limitations_not_declared",
    "human_metadata_review_incomplete"
  ],
  "rule": "Registration records declared metadata only. It is not execution, validation, scoring, ranking, recommendation or model admission."
}
